# ---- Routes & dates to monitor -------------------------------------------
# Comma-separated routes as ORIGIN-DESTINATION[@YYYY-MM-DD] (IATA codes).
# The optional "@date" sets a per-route target; routes without one use
# DEPART_DATE below. Each route is scanned +/- DATE_WINDOW_DAYS around its date.
#   HAN-BUD@2026-07-23  -> Vietnam (Hanoi) to Budapest, ~23 Jul
#   SGN-BUD@2026-07-23  -> Vietnam (Saigon) to Budapest, ~23 Jul
#   BUD-TLV@2026-08-03  -> Budapest to Tel Aviv (Israel), ~3 Aug
ROUTES=HAN-BUD@2026-07-23,SGN-BUD@2026-07-23,BUD-TLV@2026-08-03

# Default departure date for routes given without an "@date".
DEPART_DATE=2026-07-23
# +/- window (in days) scanned around each route's target date.
DATE_WINDOW_DAYS=2

# Max acceptable stops (1 = one connection, which is the norm Vietnam -> Budapest).
MAX_STOPS=1

# ---- Detection thresholds -------------------------------------------------
# A drop is "abnormal" when the new price is this fraction below the previous one.
DROP_THRESHOLD=0.12
# An offer is a "deal" when its price is at or below this (currency below) per route.
DEAL_PRICE=300
CURRENCY=USD

# ---- Provider -------------------------------------------------------------
# Active price provider:
#   mock        -> offline demo data, works out of the box (default)
#   playwright  -> LIVE Google Flights scraping (needs: npm i && npm run install:browser)
#   skyscanner  -> stub template to fill in
PROVIDER=mock
# Per-provider cooldown (ms) between requests, to stay polite and avoid anti-bot blocks.
PROVIDER_COOLDOWN_MS=4000

# ---- Playwright provider (only used when PROVIDER=playwright) -------------
# Run the browser headless (true) or visibly for debugging (false).
HEADLESS=true
# Per-page navigation/scrape timeout in ms.
NAV_TIMEOUT_MS=45000
# Browser locale & timezone (affects currency/consent wall behaviour).
PW_LOCALE=en-US
PW_TIMEZONE=UTC

# ---- Email (daily summary) -----------------------------------------------
# Leave EMAIL_TO empty to fall back to writing the summary to data/summaries/.
EMAIL_TO=nextframe2024@gmail.com
EMAIL_FROM=Flight Monitor <bot@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Logging --------------------------------------------------------------
# text | json
LOG_FORMAT=text
LOG_LEVEL=info
