# Credentials for calling the WhatsApp Business Cloud API DIRECTLY.
#
# NOT needed for the WhatsApp Business Tools MCP server — that uses OAuth
# sign-in, not a stored token. See docs/whatsapp-business-tools-mcp.md.
#
# Copy to .env and fill in. .env is gitignored — never commit real values.

# System User access token (long-lived). A token from the App Dashboard's
# "API setup" panel expires within hours and is only for local testing.
# The MCP tool whatsapp_biz_system_user_token returns a link for generating one.
WHATSAPP_ACCESS_TOKEN=

# From App Dashboard > WhatsApp > API setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
